# MongoDB database connection
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER/YOUR_DATABASE?retryWrites=true&w=majority

# Admin login credentials (used by the existing login route)
ADMIN_USERNAME=change-this-username
ADMIN_PASSWORD=use-a-long-unique-password

# Random secret, at least 32 characters; generate a unique value for production
ADMIN_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
